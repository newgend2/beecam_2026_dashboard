{
  "name": "beecam-2026-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "refresh:positives": "python3 scripts/build_positive_assets.py",
    "validate:data": "node scripts/validate-camera-data.mjs && node scripts/validate-positive-data.mjs",
    "test": "vitest run",
    "build": "npm run validate:data && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.2.2",
    "typescript": "~5.9.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "jsdom": "^27.2.0",
    "vitest": "^4.0.10"
  }
}
